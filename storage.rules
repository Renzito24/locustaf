rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ====================================================================
    // HELPER FUNCTIONS
    // ====================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function getRole() {
      return getUserData().rol;
    }

    function getCompanyId() {
      return getUserData().companyId;
    }

    function isSuperadmin() {
      return isAuthenticated() && getRole() == 'superadmin';
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'admin';
    }

    // ====================================================================
    // MEDICAL DOCUMENTS
    // Path: companies/{companyId}/medical_documents/{userId}/{fileName}
    // Superadmin : full access
    // Admin      : full access de su empresa
    // Empl       : read/create/update/delete own files (justificativos)
    // ====================================================================
    match /companies/{companyId}/medical_documents/{userId}/{fileName} {
      allow read: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && companyId == getCompanyId())
            || (request.auth.uid == userId && companyId == getCompanyId()));
      allow create: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && companyId == getCompanyId())
            || (request.auth.uid == userId && companyId == getCompanyId()));
      allow update: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && companyId == getCompanyId())
            || (request.auth.uid == userId && companyId == getCompanyId()));
      allow delete: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && companyId == getCompanyId())
            || (request.auth.uid == userId && companyId == getCompanyId()));
    }

    // ====================================================================
    // DEFAULT: deny all access to unknown paths
    // ====================================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
