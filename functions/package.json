{
  "name": "functions",
  "description": "Cloud Functions para LOCUSTAF",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test",
    "test:integration": "firebase emulators:exec --only firestore \"node --test --test-concurrency=1\"",
    "test:trial": "set LOCUSTAF_TRIAL_INTEGRATION=1&& firebase emulators:exec --only firestore,functions \"node --test test/registerCompanyTrial.integration.test.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2"
  },
  "private": true
}
