rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================================
    // HELPER FUNCTIONS
    // ====================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function getRole() {
      return getUserData().rol;
    }

    function getCompanyId() {
      return getUserData().companyId;
    }

    function isSuperadmin() {
      return isAuthenticated() && getRole() == 'superadmin';
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'admin';
    }

    function isSupervisor() {
      return isAuthenticated() && getRole() == 'supervisor';
    }

    function isEmployee() {
      return isAuthenticated() && getRole() == 'employee';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // El documento pertenece a la empresa del usuario autenticado.
    function inCompany(companyId) {
      return isAuthenticated() && companyId == getCompanyId();
    }

    // Usuario autenticado que aún no tiene empresa asignada
    // (flujo de onboarding: crea su empresa y su documento de usuario).
    function isOnboardingUser() {
      return isAuthenticated() && getCompanyId() == null;
    }

    // En updates, los campos sensibles no pueden cambiar.
    function noSensitiveFieldChanges() {
      return request.resource.data.companyId == resource.data.companyId
        && request.resource.data.userId == resource.data.userId;
    }

    // Para la colección users, además el rol no puede cambiar salvo admin/superadmin.
    function noUserSensitiveChanges() {
      return noSensitiveFieldChanges()
        && (isSuperadmin() || isAdmin()
            || request.resource.data.rol == resource.data.rol);
    }

    // ====================================================================
    // USERS
    // Superadmin : full access (todas las empresas)
    // Admin      : read/update de su empresa, create en su empresa
    // Superv     : read de su empresa
    // Empl       : read own only
    // ====================================================================
    match /users/{uid} {
      allow read: if isAuthenticated()
        && (isSuperadmin() || inCompany(resource.data.companyId)
            || (isEmployee() && isOwner(uid)));
      allow create: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && request.resource.data.companyId == getCompanyId())
            || (isOwner(uid) && getCompanyId() == null));
      allow update: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && inCompany(resource.data.companyId)))
        && noUserSensitiveChanges();
      allow delete: if isSuperadmin();
    }

    // ====================================================================
    // COMPANIES
    // Superadmin : full access
    // Admin      : read/update de su propia empresa
    // ====================================================================
    match /companies/{companyId} {
      allow read: if isAuthenticated()
        && (isSuperadmin() || inCompany(companyId));
      allow create: if isSuperadmin() || isOnboardingUser();
      allow update: if isSuperadmin()
        || (isAdmin() && inCompany(companyId));
      allow delete: if isSuperadmin();
    }

    // ====================================================================
    // ATTENDANCES
    // Superadmin : full access
    // Admin/Superv: read de su empresa
    // Empl       : read own, manage own check-in/out
    // ====================================================================
    match /attendances/{docId} {
      allow read: if isAuthenticated()
        && (isSuperadmin() || inCompany(resource.data.companyId)
            || (isEmployee() && isOwner(resource.data.userId)));
      allow create: if isAuthenticated()
        && (isSuperadmin()
            || (isEmployee() && request.resource.data.userId == request.auth.uid
                && request.resource.data.companyId == getCompanyId()));
      allow update: if isAuthenticated()
        && (isSuperadmin()
            || (isEmployee() && resource.data.userId == request.auth.uid
                && inCompany(resource.data.companyId)))
        && noSensitiveFieldChanges();
      allow delete: if isSuperadmin();
    }

    // ====================================================================
    // WORKPLACES
    // Superadmin : full access
    // Admin      : full access de su empresa
    // Superv     : read de su empresa
    // Empl       : no access
    // ====================================================================
    match /workplaces/{docId} {
      allow read: if isAuthenticated()
        && (isSuperadmin() || inCompany(resource.data.companyId));
      allow create: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && request.resource.data.companyId == getCompanyId()));
      allow update: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && inCompany(resource.data.companyId)))
        && noSensitiveFieldChanges();
      allow delete: if isSuperadmin()
        || (isAdmin() && inCompany(resource.data.companyId));
    }

    // ====================================================================
    // MEDICAL DOCUMENTS
    // Superadmin : full access
    // Admin      : full access de su empresa
    // Superv/Empl: no access
    // ====================================================================
    match /medical_documents/{docId} {
      allow read: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && inCompany(resource.data.companyId)));
      allow create: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && request.resource.data.companyId == getCompanyId()));
      allow update: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && inCompany(resource.data.companyId)))
        && noSensitiveFieldChanges();
      allow delete: if isSuperadmin()
        || (isAdmin() && inCompany(resource.data.companyId));
    }

    // ====================================================================
    // INCIDENCES
    // Superadmin : full access
    // Admin      : full access de su empresa
    // Superv     : read de su empresa
    // Empl       : no access
    // ====================================================================
    match /incidences/{docId} {
      allow read: if isAuthenticated()
        && (isSuperadmin() || inCompany(resource.data.companyId));
      allow create: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && request.resource.data.companyId == getCompanyId()));
      allow update: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && inCompany(resource.data.companyId)))
        && noSensitiveFieldChanges();
      allow delete: if isSuperadmin()
        || (isAdmin() && inCompany(resource.data.companyId));
    }

    // ====================================================================
    // ATTENDANCE LOCKS (internal concurrency control)
    // ====================================================================
    match /_attendance_locks/{lockId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
