rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================================
    // HELPER FUNCTIONS
    // ====================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // VUL-1: getUserData()/getRole()/getCompanyId() deben tolerar la ausencia
    // del documento del usuario (flujo de onboarding, donde el usuario crea su
    // propio documento). Acceder a campos de un doc inexistente lanza
    // "Null value error" y rompe la evaluación de la regla.
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function getRole() {
      let data = getUserData();
      return data != null ? data.rol : null;
    }

    function getCompanyId() {
      let data = getUserData();
      return data != null ? data.companyId : null;
    }

    function isSuperadmin() {
      return isAuthenticated() && getRole() == 'superadmin';
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'admin';
    }

    function isSupervisor() {
      return isAuthenticated() && getRole() == 'supervisor';
    }

    function isEmployee() {
      return isAuthenticated() && getRole() == 'employee';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // El documento pertenece a la empresa del usuario autenticado.
    // Requiere companyId no nulo para evitar que usuarios sin empresa
    // (onboarding) puedan leer documentos ajenos con companyId vacío.
    function inCompany(companyId) {
      return isAuthenticated() && companyId != null && companyId == getCompanyId();
    }

    // Usuario autenticado que aún no tiene empresa asignada
    // (flujo de onboarding: crea su empresa y su documento de usuario).
    function isOnboardingUser() {
      return isAuthenticated() && getCompanyId() == null;
    }

    // Tolerancia (en milisegundos) que permite el check-in respecto del tiempo
    // del servidor. Se lee de la configuración de la empresa (campo
    // `toleranciaCheckIn` en minutos, editable por el admin). Default 15 min.
    function getCompanyToleranceMinutes(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data.toleranciaCheckIn;
    }

    function getCheckInToleranceMillis(companyId) {
      return (companyId != null
          && exists(/databases/$(database)/documents/companies/$(companyId))
          && getCompanyToleranceMinutes(companyId) != null
              ? getCompanyToleranceMinutes(companyId)
              : 15) * 60000;
    }

    // VUL-3: en el alta de una asistencia directa escrita en Firestore, el
    // cliente no puede fijar una hora de entrada arbitraria. checkInTime debe
    // ser un timestamp dentro de la tolerancia configurada vs el tiempo del
    // servidor, y la asistencia debe crearse siempre como 'active' sin campos
    // de cierre.
    // AUI-02 (Fase 2): la geocerca YA NO se valida en rules (Firestore Rules
    // no soporta trigonometría). El self check-in pasa obligatoriamente por la
    // callable `checkInGeo` (Cloud Function) que calcula la distancia Haversine
    // en el servidor. Por eso el alta directa del empleado quedó bloqueada:
    // solo se permiten aquí el alta del superadmin y la manual del admin
    // (AUI-06, que no exige ubicación).
    function validAttendanceConstraints(companyId, checkInTime) {
      let diff = checkInTime.toMillis() - request.time.toMillis();
      let toleranceMillis = getCheckInToleranceMillis(companyId);
      return request.resource.data.status == 'active'
        && !('checkOutTime' in request.resource.data)
        && !('durationMinutes' in request.resource.data)
        && diff >= -toleranceMillis
        && diff <= toleranceMillis;
    }

    function validWorkplace(companyId, workplaceId) {
      return exists(/databases/$(database)/documents/workplaces/$(workplaceId))
        && get(/databases/$(database)/documents/workplaces/$(workplaceId)).data.companyId == companyId
        && get(/databases/$(database)/documents/workplaces/$(workplaceId)).data.isActive == true;
    }

    // Alta manual (admin en nombre de un empleado, AUI-06): control de lugar de
    // trabajo y tolerancia, sin exigir ubicación ni geocerca (el empleado puede
    // no estar presente físicamente).
    function validManualAttendanceCreate() {
      return validAttendanceConstraints(
          request.resource.data.companyId, request.resource.data.checkInTime)
        && validWorkplace(
          request.resource.data.companyId, request.resource.data.workplaceId);
    }

    // En updates, los campos sensibles no pueden cambiar. Compara la identidad
    // del documento según la colección ([identityField]): 'id' para
    // users/workplaces, 'userId' para attendances/incidences/medical_documents.
    function noSensitiveFieldChanges(identityField) {
      return request.resource.data.companyId == resource.data.companyId
        && request.resource.data[identityField] == resource.data[identityField];
    }

    // VUL-4b/M1: en el alta de incidencias y documentos médicos el estado solo
    // puede ser 'pendiente' y no se pueden fijar los campos de revisión, para
    // evitar que el cliente cree justificativos auto-aprobados.
    function validServiceCreate() {
      return request.resource.data.estado == 'pendiente'
        && !('reviewedBy' in request.resource.data)
        && !('reviewedAt' in request.resource.data);
    }

    // En updates de asistencias, los campos fijados en el check-in y la identidad
    // no pueden cambiar (evita falsificar hora de entrada, fecha, lugar o
    // coordenadas de ingreso). Además se protegen los campos server-only:
    //  - El estado solo puede pasar 'active' -> 'completed' (nunca reabrir), y
    //    para completar una jornada se debe fijar checkOutTime.
    //  - Un checkOutTime existente no puede modificarse ni eliminarse.
    //  - durationMinutes se deriva del servidor (checkOutTime - checkInTime);
    //    el cliente no puede fijar una duración arbitraria.
    //  - isOrphaned solo puede marcarse como true (jornada huérfana), nunca
    //    borrarse ni pasarse a false desde el cliente.
    function noAttendanceServerFieldChanges() {
      let identityOk = request.resource.data.userId == resource.data.userId
        && request.resource.data.companyId == resource.data.companyId;
      let checkInFrozen = request.resource.data.checkInTime == resource.data.checkInTime
        && request.resource.data.date == resource.data.date
        && request.resource.data.isLate == resource.data.isLate
        && request.resource.data.workplaceId == resource.data.workplaceId
        && request.resource.data.checkInLatitud == resource.data.checkInLatitud
        && request.resource.data.checkInLongitud == resource.data.checkInLongitud;
      let statusOk = request.resource.data.status == resource.data.status
        || (resource.data.status == 'active'
            && request.resource.data.status == 'completed'
            && 'checkOutTime' in request.resource.data);
      let checkOutImmutable = !('checkOutTime' in resource.data)
        || (('checkOutTime' in request.resource.data)
            && request.resource.data.checkOutTime == resource.data.checkOutTime);
      let durationOk = !('durationMinutes' in request.resource.data)
        || !('checkOutTime' in request.resource.data)
        || (request.resource.data.checkOutTime.toMillis() - resource.data.checkInTime.toMillis()
            >= request.resource.data.durationMinutes * 60000
            && request.resource.data.checkOutTime.toMillis() - resource.data.checkInTime.toMillis()
            < (request.resource.data.durationMinutes + 1) * 60000);
      let orphanOk = !('isOrphaned' in request.resource.data)
        || request.resource.data.isOrphaned == true
        || (('isOrphaned' in resource.data)
            && request.resource.data.isOrphaned == resource.data.isOrphaned);
      return identityOk && checkInFrozen && statusOk
        && checkOutImmutable && durationOk && orphanOk;
    }

    // Para la colección users:
    //  - Superadmin puede modificar cualquier campo (incluido el rol).
    //  - El dueño de su propio documento (incluido un admin) no puede cambiar
    //    su rol, isActive ni isDeleted.
    //  - Un admin puede editar empleados/supervisores de su empresa, inclusive
    //    el rol, pero NUNCA asignar 'admin'/'superadmin' (bloquea la escalada
    //    admin -> superadmin que rompería el aislamiento multiempresa).
    //  - Empleado/supervisor vía owner path: el rol no puede cambiar.
    //    (isOwnProfileUpdate ya exige el resto de campos sensibles intactos).
    function noUserSensitiveChanges() {
      let allowed = noSensitiveFieldChanges('id');
      let selfSensitiveUnchanged = request.auth.uid == resource.data.id
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.isDeleted == resource.data.isDeleted;
      let adminRoleClamped = isAdmin()
        && request.auth.uid != resource.data.id
        && (request.resource.data.rol == 'employee'
            || request.resource.data.rol == 'supervisor');
      return allowed
        && (isSuperadmin()
            || adminRoleClamped
            || selfSensitiveUnchanged);
    }

    // Un usuario solo puede actualizar su propio perfil y únicamente campos
    // no sensibles (nombre, apellido, telefono, updatedAt). Los campos
    // sensibles (id, email, dni, rol, isActive, isDeleted, companyId,
    // lugarDeTrabajoId, createdAt) deben permanecer idénticos.
    function isOwnProfileUpdate() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && request.resource.data.dni == resource.data.dni
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.isDeleted == resource.data.isDeleted
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.lugarDeTrabajoId == resource.data.lugarDeTrabajoId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // ====================================================================
    // USERS
    // Superadmin : full access (todas las empresas)
    // Admin      : read/update de su empresa, create en su empresa
    // Superv     : read de su empresa
    // Empl       : read own only
    // ====================================================================
    match /users/{uid} {
      allow read: if isAuthenticated()
        && (isSuperadmin() || isOwner(uid)
            || ((isAdmin() || isSupervisor()) && inCompany(resource.data.companyId)));
      allow create: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin()
                && request.resource.data.companyId == getCompanyId()
                && (request.resource.data.rol == 'employee'
                    || request.resource.data.rol == 'supervisor'))
            || (isOwner(uid) && getCompanyId() == null
                && request.resource.data.rol == 'admin'
                && request.resource.data.companyId != null
                && exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId))
                && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.createdBy == request.auth.uid));
      allow update: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && inCompany(resource.data.companyId))
            || (isOwner(uid) && isOwnProfileUpdate()))
        && noUserSensitiveChanges();
      allow delete: if isSuperadmin();
    }

    // AUI-05: el admin puede editar la configuración de su empresa pero no
    // reasignar la propiedad (createdBy), que queda fijada en el onboarding.
    function companyNoOwnerChange() {
      return request.resource.data.createdBy == resource.data.createdBy;
    }

    // ====================================================================
    // COMPANIES
    // Superadmin : full access
    // Admin      : read/update de su propia empresa
    // ====================================================================
    match /companies/{companyId} {
      allow read: if isAuthenticated()
        && (isSuperadmin() || inCompany(companyId));
      allow create: if isSuperadmin()
        || (isOnboardingUser() && request.resource.data.createdBy == request.auth.uid);
      allow update: if isSuperadmin()
        || (isAdmin() && inCompany(companyId) && companyNoOwnerChange());
      // El delete solo lo permite el superadmin. Excepción: el usuario en
      // onboarding puede eliminar una empresa que acaba de crear si falló el
      // alta de su documento de admin (limpieza de empresa huérfana), siempre
      // que aún no tenga empresa asignada.
      allow delete: if isSuperadmin()
        || (isOnboardingUser()
            && resource.data.createdBy == request.auth.uid);
    }

    // ====================================================================
    // ATTENDANCES
    // Superadmin : full access
    // Admin/Superv: read de su empresa
    // Empl       : read own, manage own check-in/out
    // ====================================================================
    match /attendances/{docId} {
      allow read: if isAuthenticated()
        && (isSuperadmin() || inCompany(resource.data.companyId)
            || (isEmployee() && isOwner(resource.data.userId)));
      allow create: if isAuthenticated()
        && (isSuperadmin()
            // AUI-06: alta manual de un ingreso (admin en nombre de un
            // empleado), sin exigir ubicación.
            // AUI-02 (Fase 2): el self check-in ya NO se puede crear directo
            // desde el cliente; pasa por la callable `checkInGeo` que valida
            // la geocerca (Haversine) en el servidor.
            || (isAdmin() && inCompany(request.resource.data.companyId)
                && request.resource.data.userId != request.auth.uid
                && validManualAttendanceCreate()));
      allow update: if isAuthenticated()
        && (isSuperadmin()
            || (isEmployee() && resource.data.userId == request.auth.uid
                && inCompany(resource.data.companyId)))
        && (isSuperadmin() || noAttendanceServerFieldChanges());
      allow delete: if isSuperadmin();
    }

    // ====================================================================
    // WORKPLACES
    // Superadmin : full access
    // Admin      : full access de su empresa
    // Superv     : read de su empresa
    // Empl       : no access
    // ====================================================================
    match /workplaces/{docId} {
      allow read: if isAuthenticated()
        && (isSuperadmin() || inCompany(resource.data.companyId));
      allow create: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && request.resource.data.companyId == getCompanyId()));
      allow update: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && inCompany(resource.data.companyId)))
        && noSensitiveFieldChanges('id');
      allow delete: if isSuperadmin()
        || (isAdmin() && inCompany(resource.data.companyId));
    }

    // ====================================================================
    // MEDICAL DOCUMENTS
    // Superadmin : full access
    // Admin      : full access de su empresa
    // Superv     : no access
    // Empl       : create/read own (justificativos)
    // ====================================================================
    match /medical_documents/{docId} {
      allow read: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && inCompany(resource.data.companyId))
            || (isEmployee() && isOwner(resource.data.userId)
                && inCompany(resource.data.companyId)));
      allow create: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && request.resource.data.companyId == getCompanyId()
                && validServiceCreate())
            || (isEmployee() && request.resource.data.userId == request.auth.uid
                && request.resource.data.companyId == getCompanyId()
                && validServiceCreate()));
      allow update: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && inCompany(resource.data.companyId)))
        && noSensitiveFieldChanges('userId');
      allow delete: if isSuperadmin()
        || (isAdmin() && inCompany(resource.data.companyId));
    }

    // ====================================================================
    // INCIDENCES
    // Superadmin : full access
    // Admin      : full access de su empresa
    // Superv     : read de su empresa
    // Empl       : create/read own (justificativos)
    // ====================================================================
    match /incidences/{docId} {
      allow read: if isAuthenticated()
        && (isSuperadmin()
            || ((isAdmin() || isSupervisor()) && inCompany(resource.data.companyId))
            || (isEmployee() && isOwner(resource.data.userId)));
      allow create: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && request.resource.data.companyId == getCompanyId()
                && validServiceCreate())
            || (isEmployee() && request.resource.data.userId == request.auth.uid
                && request.resource.data.companyId == getCompanyId()
                && validServiceCreate()));
      allow update: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && inCompany(resource.data.companyId)))
        && noSensitiveFieldChanges('userId');
      allow delete: if isSuperadmin()
        || (isAdmin() && inCompany(resource.data.companyId));
    }

    // ====================================================================
    // ATTENDANCE LOCKS (internal concurrency control)
    // ====================================================================
    match /_attendance_locks/{lockId} {
      allow read: if isAuthenticated()
        && (isSuperadmin() || lockId == request.auth.uid);
      allow write: if isAuthenticated()
        && (isSuperadmin() || lockId == request.auth.uid);
    }
  }
}
