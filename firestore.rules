rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================================
    // HELPER FUNCTIONS
    // ====================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // VUL-1: getUserData()/getRole()/getCompanyId() deben tolerar la ausencia
    // del documento del usuario (flujo de onboarding, donde el usuario crea su
    // propio documento). Acceder a campos de un doc inexistente lanza
    // "Null value error" y rompe la evaluación de la regla.
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function getRole() {
      let data = getUserData();
      return data != null ? data.rol : null;
    }

    function getCompanyId() {
      let data = getUserData();
      return data != null ? data.companyId : null;
    }

    function isSuperadmin() {
      return isAuthenticated() && getRole() == 'superadmin';
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'admin';
    }

    function isSupervisor() {
      return isAuthenticated() && getRole() == 'supervisor';
    }

    function isEmployee() {
      return isAuthenticated() && getRole() == 'employee';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // El documento pertenece a la empresa del usuario autenticado.
    // Requiere companyId no nulo para evitar que usuarios sin empresa
    // (onboarding) puedan leer documentos ajenos con companyId vacío.
    function inCompany(companyId) {
      return isAuthenticated() && companyId != null && companyId == getCompanyId();
    }

    // Usuario autenticado que aún no tiene empresa asignada
    // (flujo de onboarding: crea su empresa y su documento de usuario).
    function isOnboardingUser() {
      return isAuthenticated() && getCompanyId() == null;
    }

    // Tolerancia (en milisegundos) que permite el check-in respecto del tiempo
    // del servidor. Se lee de la configuración de la empresa (campo
    // `toleranciaCheckIn` en minutos, editable por el admin). Default 15 min.
    function getCompanyToleranceMinutes(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data.toleranciaCheckIn;
    }

    function getCheckInToleranceMillis(companyId) {
      return (companyId != null
          && exists(/databases/$(database)/documents/companies/$(companyId))
          && getCompanyToleranceMinutes(companyId) != null
              ? getCompanyToleranceMinutes(companyId)
              : 15) * 60000;
    }

    // VUL-3: en el alta de una asistencia el cliente no puede fijar una hora
    // de entrada arbitraria. checkInTime debe ser un timestamp dentro de la
    // tolerancia configurada vs el tiempo del servidor, y la asistencia debe
    // crearse siempre como 'active' sin campos de cierre.
    function validAttendanceCreate() {
      let companyId = request.resource.data.companyId;
      let diff = request.resource.data.checkInTime.toMillis() - request.time.toMillis();
      let toleranceMillis = getCheckInToleranceMillis(companyId);
      return request.resource.data.status == 'active'
        && !('checkOutTime' in request.resource.data)
        && !('durationMinutes' in request.resource.data)
        && diff >= -toleranceMillis
        && diff <= toleranceMillis;
    }

    // En updates, los campos sensibles no pueden cambiar.
    function noSensitiveFieldChanges() {
      return request.resource.data.companyId == resource.data.companyId
        && request.resource.data.userId == resource.data.userId;
    }

    // VUL-4b/M1: en el alta de incidencias y documentos médicos el estado solo
    // puede ser 'pendiente' y no se pueden fijar los campos de revisión, para
    // evitar que el cliente cree justificativos auto-aprobados.
    function validServiceCreate() {
      return request.resource.data.estado == 'pendiente'
        && !('reviewedBy' in request.resource.data)
        && !('reviewedAt' in request.resource.data);
    }

    // En updates de asistencias, los campos fijados en el check-in no pueden
    // cambiar (evita falsificar hora de entrada, fecha, lugar o coordenadas).
    // El empleado solo puede modificar checkOutTime, durationMinutes, status
    // y coordenadas de salida.
    function noAttendanceServerFieldChanges() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.checkInTime == resource.data.checkInTime
        && request.resource.data.date == resource.data.date
        && request.resource.data.isLate == resource.data.isLate
        && request.resource.data.workplaceId == resource.data.workplaceId
        && request.resource.data.checkInLatitud == resource.data.checkInLatitud
        && request.resource.data.checkInLongitud == resource.data.checkInLongitud;
    }

    // Para la colección users, además el rol no puede cambiar salvo admin/superadmin.
    function noUserSensitiveChanges() {
      return noSensitiveFieldChanges()
        && (isSuperadmin() || isAdmin()
            || request.resource.data.rol == resource.data.rol);
    }

    // Un usuario solo puede actualizar su propio perfil y únicamente campos
    // no sensibles (nombre, apellido, telefono, updatedAt). Los campos
    // sensibles (id, email, dni, rol, isActive, isDeleted, companyId,
    // lugarDeTrabajoId, createdAt) deben permanecer idénticos.
    function isOwnProfileUpdate() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && request.resource.data.dni == resource.data.dni
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.isDeleted == resource.data.isDeleted
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.lugarDeTrabajoId == resource.data.lugarDeTrabajoId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // ====================================================================
    // USERS
    // Superadmin : full access (todas las empresas)
    // Admin      : read/update de su empresa, create en su empresa
    // Superv     : read de su empresa
    // Empl       : read own only
    // ====================================================================
    match /users/{uid} {
      allow read: if isAuthenticated()
        && (isSuperadmin() || isOwner(uid)
            || ((isAdmin() || isSupervisor()) && inCompany(resource.data.companyId)));
      allow create: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin()
                && request.resource.data.companyId == getCompanyId()
                && (request.resource.data.rol == 'employee'
                    || request.resource.data.rol == 'supervisor'))
            || (isOwner(uid) && getCompanyId() == null
                && request.resource.data.rol == 'admin'
                && request.resource.data.companyId != null
                && exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId))
                && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.createdBy == request.auth.uid));
      allow update: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && inCompany(resource.data.companyId))
            || (isOwner(uid) && isOwnProfileUpdate()))
        && noUserSensitiveChanges();
      allow delete: if isSuperadmin();
    }

    // ====================================================================
    // COMPANIES
    // Superadmin : full access
    // Admin      : read/update de su propia empresa
    // ====================================================================
    match /companies/{companyId} {
      allow read: if isAuthenticated()
        && (isSuperadmin() || inCompany(companyId));
      allow create: if isSuperadmin()
        || (isOnboardingUser() && request.resource.data.createdBy == request.auth.uid);
      allow update: if isSuperadmin()
        || (isAdmin() && inCompany(companyId));
      allow delete: if isSuperadmin();
    }

    // ====================================================================
    // ATTENDANCES
    // Superadmin : full access
    // Admin/Superv: read de su empresa
    // Empl       : read own, manage own check-in/out
    // ====================================================================
    match /attendances/{docId} {
      allow read: if isAuthenticated()
        && (isSuperadmin() || inCompany(resource.data.companyId)
            || (isEmployee() && isOwner(resource.data.userId)));
      allow create: if isAuthenticated()
        && (isSuperadmin()
            || (isEmployee() && request.resource.data.userId == request.auth.uid
                && request.resource.data.companyId == getCompanyId()
                && validAttendanceCreate()));
      allow update: if isAuthenticated()
        && (isSuperadmin()
            || (isEmployee() && resource.data.userId == request.auth.uid
                && inCompany(resource.data.companyId)))
        && (isSuperadmin() || noAttendanceServerFieldChanges());
      allow delete: if isSuperadmin();
    }

    // ====================================================================
    // WORKPLACES
    // Superadmin : full access
    // Admin      : full access de su empresa
    // Superv     : read de su empresa
    // Empl       : no access
    // ====================================================================
    match /workplaces/{docId} {
      allow read: if isAuthenticated()
        && (isSuperadmin() || inCompany(resource.data.companyId));
      allow create: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && request.resource.data.companyId == getCompanyId()));
      allow update: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && inCompany(resource.data.companyId)))
        && noSensitiveFieldChanges();
      allow delete: if isSuperadmin()
        || (isAdmin() && inCompany(resource.data.companyId));
    }

    // ====================================================================
    // MEDICAL DOCUMENTS
    // Superadmin : full access
    // Admin      : full access de su empresa
    // Superv     : no access
    // Empl       : create/read own (justificativos)
    // ====================================================================
    match /medical_documents/{docId} {
      allow read: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && inCompany(resource.data.companyId))
            || (isEmployee() && isOwner(resource.data.userId)
                && inCompany(resource.data.companyId)));
      allow create: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && request.resource.data.companyId == getCompanyId()
                && validServiceCreate())
            || (isEmployee() && request.resource.data.userId == request.auth.uid
                && request.resource.data.companyId == getCompanyId()
                && validServiceCreate()));
      allow update: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && inCompany(resource.data.companyId)))
        && noSensitiveFieldChanges();
      allow delete: if isSuperadmin()
        || (isAdmin() && inCompany(resource.data.companyId));
    }

    // ====================================================================
    // INCIDENCES
    // Superadmin : full access
    // Admin      : full access de su empresa
    // Superv     : read de su empresa
    // Empl       : create/read own (justificativos)
    // ====================================================================
    match /incidences/{docId} {
      allow read: if isAuthenticated()
        && (isSuperadmin()
            || ((isAdmin() || isSupervisor()) && inCompany(resource.data.companyId))
            || (isEmployee() && isOwner(resource.data.userId)));
      allow create: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && request.resource.data.companyId == getCompanyId()
                && validServiceCreate())
            || (isEmployee() && request.resource.data.userId == request.auth.uid
                && request.resource.data.companyId == getCompanyId()
                && validServiceCreate()));
      allow update: if isAuthenticated()
        && (isSuperadmin()
            || (isAdmin() && inCompany(resource.data.companyId)))
        && noSensitiveFieldChanges();
      allow delete: if isSuperadmin()
        || (isAdmin() && inCompany(resource.data.companyId));
    }

    // ====================================================================
    // ATTENDANCE LOCKS (internal concurrency control)
    // ====================================================================
    match /_attendance_locks/{lockId} {
      allow read: if isAuthenticated()
        && (isSuperadmin() || lockId == request.auth.uid);
      allow write: if isAuthenticated()
        && (isSuperadmin() || lockId == request.auth.uid);
    }
  }
}
